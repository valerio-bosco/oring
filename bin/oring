#!/usr/bin/env bash
# oring: agent panel for the serpantinum shell.
#
#   oring daemon          run the daemon (normally a systemd user service)
#   oring ui              run the panel (normally a systemd user service)
#   oring gateways        run the messaging gateways, e.g. Telegram (systemd user service)
#   oring toggle | open | close
#   oring ask <text>      open the panel and send a message
#   oring send [--auto allow|deny] <text>   send from the terminal and print the answer
#   oring state | select <agent> | new | cancel
#   oring mcp             run the desktop MCP server (for other MCP clients, e.g. `claude mcp add`)
set -euo pipefail

share=${ORING_SHARE:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}
python=${ORING_PYTHON:-python3}
quickshell=${ORING_QUICKSHELL:-quickshell}
export ORING_BIN=${ORING_BIN:-$(readlink -f "$0")}
export ORING_DESKTOP_MCP=${ORING_DESKTOP_MCP:-$(readlink -f "$0") mcp}
ui=(-p "$share/ui/shell.qml")

case "${1:-}" in
  daemon|gateways|send|state|select|new|cancel)
          PYTHONPATH="$share${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m oring "$@" ;;
  ui)     exec "$quickshell" "${ui[@]}" ;;
  toggle|open|close) exec "$quickshell" "${ui[@]}" ipc call oring "$1" ;;
  ask)    shift; exec "$quickshell" "${ui[@]}" ipc call oring ask "$*" ;;
  permission-mcp) exec "$python" "$share/mcp/permission_mcp.py" ;;
  mcp)
    # Started outside the graphical session (e.g. from a root shell): find the user's running
    # Hyprland instance and its Wayland display
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v hyprctl >/dev/null; then
      if [ ! -d "${XDG_RUNTIME_DIR:-/nonexistent}/hypr" ]; then
        for d in /run/user/*/hypr; do [ -d "$d" ] && export XDG_RUNTIME_DIR=${d%/hypr} && break; done
      fi
      instance=$(hyprctl instances -j 2>/dev/null | "$python" -c 'import json,sys; i=sorted(json.load(sys.stdin), key=lambda x: x.get("time", 0)); print(json.dumps(i[-1]) if i else "")' || true)
      if [ -n "$instance" ]; then
        export HYPRLAND_INSTANCE_SIGNATURE=$("$python" -c 'import json,sys; print(json.loads(sys.argv[1])["instance"])' "$instance")
        export WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-$("$python" -c 'import json,sys; print(json.loads(sys.argv[1])["wl_socket"])' "$instance")}
      fi
    fi
    exec "$python" "$share/mcp/desktop_mcp.py" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
